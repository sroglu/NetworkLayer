<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roslyn incremental source generator for PFound.NetworkLayer.
    Builds OUTSIDE Unity to a netstandard2.0 DLL, then the DLL is imported into Unity as a
    RoslynAnalyzer-labelled asset (see ../Plugins/PFound.NetworkLayer.Generator.dll.meta).

    Standard build:  dotnet build -c Release
    In-repo build (no dotnet SDK): ./build.sh  (compiles with mono csc against the Roslyn 4.3
    netstandard2.0 reference assemblies — the same version Unity 6000.3 hosts).
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <AssemblyName>PFound.NetworkLayer.Generator</AssemblyName>
    <RootNamespace>PFound.NetworkLayer.Generation</RootNamespace>
    <!-- Analyzer-release-tracking analyzer (RS2008) is not run in the no-SDK csc build; suppress it so
         `dotnet build` stays clean too without shipping AnalyzerReleases.*.md tracking files. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <!-- Pin to the exact System.Collections.Immutable the Unity 6000.3 Roslyn host binds (6.0.0.0).
         A newer version makes Unity's compiler silently skip loading this analyzer. -->
    <PackageReference Include="System.Collections.Immutable" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
